---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { buildMetrikaScript, getMetrikaId } from "../../lib/metrika";

const { title, description, globals, directions, seoJsonLd = [], children } = Astro.props;
const metrikaId = getMetrikaId();
const metrikaScript = buildMetrikaScript(metrikaId);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {seoJsonLd.map((json) => (
      <script type="application/ld+json" set:html={JSON.stringify(json)} />
    ))}
    {metrikaScript && <Fragment set:html={metrikaScript} />}
    {metrikaId && <script>{`window.PUBLIC_METRIKA_ID = ${JSON.stringify(metrikaId)};`}</script>}
    <style>
      :root {
        color-scheme: light;
        --bg: #f6f7fb;
        --card: #ffffff;
        --text: #12131a;
        --muted: #5f6372;
        --accent: #2b66ff;
        --accent-soft: rgba(43, 102, 255, 0.15);
        --shadow: 0 20px 40px rgba(20, 24, 36, 0.08);
        --radius: 20px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1120px, 92%);
        margin: 0 auto;
      }

      .muted {
        color: var(--muted);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--accent);
        color: white;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 12px 24px rgba(43, 102, 255, 0.3);
      }

      .btn.secondary {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
        box-shadow: none;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(246, 247, 251, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(18, 19, 26, 0.08);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
      }

      .logo {
        font-size: 20px;
        font-weight: 700;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .nav-dropdown {
        position: relative;
      }

      .nav-dropdown summary {
        list-style: none;
        cursor: pointer;
      }

      .nav-dropdown summary::-webkit-details-marker {
        display: none;
      }

      .dropdown {
        position: absolute;
        top: 120%;
        left: 0;
        background: var(--card);
        border-radius: 12px;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        min-width: 200px;
        padding: 12px;
        gap: 8px;
      }

      .nav-dropdown:not([open]) .dropdown {
        display: none;
      }

      main {
        display: flex;
        flex-direction: column;
        gap: 72px;
        padding: 48px 0 72px;
      }

      section {
        padding: 0;
      }

      .section-card {
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 32px;
      }

      .site-footer {
        background: #0f1324;
        color: #f0f2ff;
        padding: 48px 0 24px;
      }

      .footer-inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 32px;
      }

      .contact-list {
        padding: 0;
        list-style: none;
        display: grid;
        gap: 8px;
      }

      .footer-bottom {
        text-align: center;
        margin-top: 32px;
        color: rgba(240, 242, 255, 0.7);
      }

      @media (max-width: 720px) {
        .header-inner {
          flex-direction: column;
          gap: 12px;
          align-items: flex-start;
        }

        .nav {
          width: 100%;
          justify-content: space-between;
        }

        .dropdown {
          position: static;
        }
      }
    </style>
  </head>
  <body>
    <Header globals={globals} directions={directions} />
    <main>
      {children}
    </main>
    <Footer globals={globals} />
  </body>
</html>
